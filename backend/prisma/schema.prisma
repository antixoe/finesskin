generator client {
  provider             = "prisma-client"
  output               = "../generated/prisma"
  moduleFormat         = "esm"
  generatedFileExtension = "ts"
  importFileExtension  = "ts"
}

datasource db {
  provider = "sqlite"
}

enum RoutineTiming {
  AM
  PM
}

enum ProductCategory {
  CLEANSER
  TONER
  SERUM
  MOISTURIZER
  SUNSCREEN
  TREATMENT
  OTHER
}

enum ScanSource {
  UPLOAD
  CAMERA
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  avatarUrl String?
  role      UserRole  @default(CUSTOMER)
  password  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products  Product[]
  routines  Routine[]
  scans     SkinScan[]
}

model Product {
  id          String          @id @default(cuid())
  userId      String
  name        String
  category    ProductCategory
  timing      RoutineTiming
  brand       String?
  notes       String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineItems RoutineItem[]

  @@index([userId, category])
}

model Routine {
  id            String             @id @default(cuid())
  userId        String
  name          String
  timing        RoutineTiming
  streak        Int                @default(0)
  completedToday Boolean            @default(false)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         RoutineItem[]
  completions   RoutineCompletion[]

  @@index([userId, timing])
}

model RoutineItem {
  id         String    @id @default(cuid())
  routineId  String
  productId  String?
  title      String
  hint       String?
  order      Int       @default(0)
  isChecked  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  routine    Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([routineId, order])
}

model RoutineCompletion {
  id         String    @id @default(cuid())
  routineId  String
  completedAt DateTime  @default(now())
  note       String?

  routine    Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId, completedAt])
}

model SkinScan {
  id            String     @id @default(cuid())
  userId        String
  source        ScanSource
  imageLabel    String?
  score         Int
  hydration     Int
  redness       Int
  acne          Int
  barrier       Int
  summary       String
  recommendations Json
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
