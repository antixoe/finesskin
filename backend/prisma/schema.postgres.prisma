generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RoutineTiming {
  AM
  PM
}

enum ProductCategory {
  CLEANSER
  TONER
  SERUM
  MOISTURIZER
  SUNSCREEN
  TREATMENT
  OTHER
}

enum ScanSource {
  UPLOAD
  CAMERA
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatarUrl String?
  role      UserRole @default(CUSTOMER)
  permissions String @default("[]")
  password  String?
  waterGoal Int      @default(8)
  waterUnit String    @default("glasses")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  routines  Routine[]
  scans     SkinScan[]
  activityLogs ActivityLog[]
  habits    Habit[]
  todos     TodoItem[]
  moods     MoodEntry[]
  drinkLogs DrinkLog[]
}

model Product {
  id           String          @id @default(cuid())
  userId       String
  name         String
  category     ProductCategory
  timing       RoutineTiming
  brand        String?
  notes        String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineItems RoutineItem[]

  @@index([userId, category])
}

model Routine {
  id             String              @id @default(cuid())
  userId         String
  name           String
  timing         RoutineTiming
  streak         Int                 @default(0)
  completedToday Boolean             @default(false)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          RoutineItem[]
  completions    RoutineCompletion[]

  @@index([userId, timing])
}

model RoutineItem {
  id        String    @id @default(cuid())
  routineId String
  productId String?
  title     String
  hint      String?
  order     Int       @default(0)
  isChecked Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  routine   Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([routineId, order])
}

model RoutineCompletion {
  id          String   @id @default(cuid())
  routineId   String
  completedAt DateTime @default(now())
  note        String?

  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId, completedAt])
}

model SkinScan {
  id              String    @id @default(cuid())
  userId          String
  source          ScanSource
  imageLabel      String?
  score           Int
  hydration       Int
  redness         Int
  acne            Int
  barrier         Int
  summary         String
  recommendations Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}

model Habit {
  id           String     @id @default(cuid())
  userId       String
  title        String
  category     String     @default("General")
  emoji        String     @default("⭐")
  scheduleType String     @default("daily") // daily | weekly | dates
  weekdays     Json?      // e.g. [1, 3, 5] for weekly (0 = Sunday)
  dates        Json?      // e.g. ["2026-08-10"] for specific dates
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         HabitLog[]

  @@index([userId])
}

model HabitLog {
  id      String  @id @default(cuid())
  habitId String
  date    String
  done    Boolean @default(true)

  habit   Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model TodoItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  done      Boolean  @default(false)
  dueDate   String?
  dueTime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String
  mood      String
  cause     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DrinkLog {
  id        String   @id @default(cuid())
  userId    String
  date      String
  glasses   Int      @default(0)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
